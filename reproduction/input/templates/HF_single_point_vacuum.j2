# Psi4 HF Single Point Energy Calculation in Vacuum
# Step 2: HF/6-31G(d) single point energy using B3LYP optimized geometry

import psi4
import os
import resp

memory {{ memory | default('11 GB') }}
set_num_threads({{ nthreads | default('8') }})

os.makedirs('{{ output_path }}', exist_ok=True)

# Coordinates come from B3LYP optimized geometry
molecule {
{{ charge | default('0') }} {{ multiplicity | default('1') }}
{{ coordinates }}
}

set {
    basis 6-31G(d,p)
    geom_maxiter 1000
    scf_type df
}

print('\n================================================')
print('   HF/6-31G(d,p) Single Point Energy Calculation    ')
print('   (Starting from B3LYP optimized geometry)     ')
print('================================================\n')

energy_hf, wfn_hf = energy('hf', return_wfn=True)

# Save HF wavefunction for potential reuse
wfn_hf.to_file('{{ output_path }}/hf_wfn_vacuum')

print('\n================================================')
print('  HF/6-31G(d,p) Single Point Energy Calculation Complete              ')
print(f'  Final Energy: {energy_hf:.10f} Eh')
print('================================================\n')