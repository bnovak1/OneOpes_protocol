# Psi4 HF Single Point Energy Calculation in Implicit Water
# Step 2: HF/6-31G(d) single point energy using B3LYP optimized geometry

import psi4
import os
import resp

memory {{ memory | default('13 GB') }}
set_num_threads({{ nthreads | default('8') }})

os.makedirs('{{ output_path }}', exist_ok=True)

# Coordinates come from B3LYP optimized geometry
molecule {
{{ charge | default('0') }} {{ multiplicity | default('1') }}
{{ coordinates }}
}

# Set up the PCM solvent model
set {
    basis 6-31G(d,p)
    geom_maxiter 1000
    scf_type df
    pcm true
    pcm_scf_type total
}
pcm = {
    Units = Angstrom
    Medium {
        SolverType = IEFPCM #CPCM
        Solvent = Water
    }
    Cavity {
        RadiiSet = Bondi
        Type = GePol
        Scaling = True
        Area = 0.2
        Mode = Atoms
        Atoms = {{ element_list | default('[]') }}
        Radii = {{ radius_list | default('[]') }}
    }
}

print('\n================================================')
print('   HF/6-31G(d,p) Single Point Energy in Implicit Water  ')
print('   (Starting from HF vacuum optimized geometry)     ')
print('================================================\n')

energy_hf, wfn_hf = energy('hf', return_wfn=True)

# Save HF wavefunction for potential reuse
wfn_hf.to_file('{{ output_path }}/hf_wfn_implicit_water')

print('\n================================================')
print('  HF/6-31G(d,p) Single Point Energy Complete              ')
print(f'  Final Energy: {energy_hf:.10f} Eh')
print('================================================\n')